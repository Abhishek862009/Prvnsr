# Copy to .env.local (development) and set the same names in the hosting dashboard (production).
# Never commit real values.

# Neon connection string (use a SEPARATE Neon branch/database for development).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random string, at least 32 chars. Generate: openssl rand -base64 48
SESSION_SECRET=

# Base64 of the argon2id hash of the recovery key. Generate with: npm run recovery:hash
# (Base64 is used because raw argon2 hashes contain "$", which .env loaders try to expand.)
# RECOVERY_KEY_HASH=

# Protects POST|GET /api/cron/cleanup (daily cleanup). 24+ characters. Generate: openssl rand -base64 32
# Scheduler must send:  Authorization: Bearer <CRON_SECRET>   (Vercel Cron does this automatically)
# CRON_SECRET=

APP_TIMEZONE=Asia/Kolkata
NODE_ENV=development

# Development only. The dummy seed refuses to run unless SEED_ALLOWED=true and NODE_ENV!=production.
# SEED_ALLOWED=true
# SEED_PARENT_PASSWORD=
